NODE_ENV=development
PORT=3000
HOST=0.0.0.0
MONGODB_DB=voter-records
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
VOTERS_COLLECTION=voters
WARD_COLLECTION=wards
DEFAULT_DATASET_ID=1
SEARCH_RATE_LIMIT=60
VOTE_RATE_LIMIT=10
DEVICE_ACCESS_KEYS_FILE=.device-access-key-hashes.json
# Generate a unique random key of at least 24 characters. Required to mark a voter as voted.
VOTE_API_KEY=replace_with_a_long_random_operator_key
